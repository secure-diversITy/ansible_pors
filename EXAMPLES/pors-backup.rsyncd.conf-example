uid = nobody
gid = nobody
use chroot = yes
max connections = 20
transfer logging = yes
# timeout = 900
dont compress = *.gz *.tgz *.zip *.z *.Z *.rpm *.deb *.bz2

[backup]
        early exec = /opt/rsync-mkdir.sh
        path = /opt/backup/rsync/%RSYNC_USER_NAME%/%RSYNC_HOST_NAME%
        read only = no
        write only = yes
#       auth users = staging:rw production:rw # man rsyncd.conf!
#	secrets file = /etc/rsyncd.users # man rsyncd.conf!
#	strict modes = yes
#	hosts allow = <IP-net/mask> # man rsyncd.conf!

